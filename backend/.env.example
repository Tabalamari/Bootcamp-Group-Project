PORT=3000
NODE_ENV=development
DB_CLIENT=sqlite
DATABASE_PATH=./database.sqlite
UPLOADS_DIR=./uploads

# For Supabase PostgreSQL, set DB_CLIENT=postgres and provide the project pooler URL.
# DATABASE_URL=postgresql://...
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-secret
# SUPABASE_PROFILE_PHOTOS_BUCKET=profile-photos

# Optional when the frontend and API use different origins; comma-separated exact origins.
# CORS_ORIGINS=https://your-frontend.example

# Set only while running `npm run admin:bootstrap`, then remove from the environment.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=use-a-unique-password-of-at-least-12-characters
# ADMIN_BOOTSTRAP_DISPLAY_NAME=Platform Administrator
# ADMIN_BOOTSTRAP_COURSE_ID=software-dev
